PORT=8000
NODE_ENV=development
DB_PATH=./data/pim_sentinel.db

# AI Provider Configuration
# Set to 'google' or 'deterministic_fallback'
AI_PROVIDER=google
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.8-flash

# WooCommerce Live Adapter Credentials (Optional - Mock driver used by default)
WOO_ACTIVE_DRIVER=mock
WOO_STORE_URL=https://example-store.local
WOO_CONSUMER_KEY=ck_mock_key
WOO_CONSUMER_SECRET=cs_mock_secret
MOCK_WOO_SIMULATE_FAILURE=false
